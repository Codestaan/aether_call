# Copy to .env for local development. Never commit the real file.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aether
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173
# Max people inside a room (mesh WebRTC gets heavy past ~6)
MAX_PARTICIPANTS=6
# Store chat messages in MongoDB (auto-deleted after 7 days). Set to false for fully ephemeral chat.
PERSIST_CHAT=true
