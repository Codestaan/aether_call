# Copy to .env.local for development. On Vercel, set these in Project Settings > Environment Variables.
# Vite only exposes variables that start with VITE_ to the browser.
VITE_BACKEND_URL=http://localhost:5000

# Optional but strongly recommended for production: a TURN relay (see README "TURN servers").
# Several URLs can be comma-separated.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
